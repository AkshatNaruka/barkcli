cards:
- id: try-the-calendar-view
  title: "Try: `barkcli today` and `barkcli calendar`"
  description: |
    Anything you add with a due date shows up in the agenda and the
    ASCII calendar — for humans, no context needed.
  column: today
  priority: medium
  labels: [onboarding]
  checklist:
  - text: 'barkcli today add "Ship the thing" --due 2026-12-01'
    done: false
  - text: "barkcli today"
    done: false
  - text: "barkcli calendar"
    done: false
