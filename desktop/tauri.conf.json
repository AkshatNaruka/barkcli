{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bark",
  "version": "0.4.0",
  "identifier": "dev.barkcli.app",
  "build": {
    "frontendDist": "../web/dist",
    "beforeBuildCommand": "bash -c 'cd \"$(git rev-parse --show-toplevel)\" && bash desktop/scripts/build-web.sh'"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../web/dist/": "web/dist/"
    },
    "externalBin": ["binaries/barkcli"]
  }
}
